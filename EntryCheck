string tk6 = tickerAt(peerRaw, 6)
string tk7 = tickerAt(peerRaw, 7)
float k0 = keptPE(tk0, peerClose(tk0), peerEarn(tk0))
float k1 = keptPE(tk1, peerClose(tk1), peerEarn(tk1))
float k2 = keptPE(tk2, peerClose(tk2), peerEarn(tk2))
float k3 = keptPE(tk3, peerClose(tk3), peerEarn(tk3))
float k4 = keptPE(tk4, peerClose(tk4), peerEarn(tk4))
float k5 = keptPE(tk5, peerClose(tk5), peerEarn(tk5))
float k6 = keptPE(tk6, peerClose(tk6), peerEarn(tk6))
float k7 = keptPE(tk7, peerClose(tk7), peerEarn(tk7))

float peEps = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "TTM", ignore_invalid_symbol=true)
float stockPE = peEps > 0 ? stockClose / peEps : na
bool showPE = not isCrypto and not isCommodity and not isForex and not isIndex and not isFund and not na(peEps)

var array<float> peBasket = array.new_float()
if barstate.islast
    array.clear(peBasket)
    if not na(k0)
        array.push(peBasket, k0)
    if not na(k1)
        array.push(peBasket, k1)
    if not na(k2)
        array.push(peBasket, k2)
    if not na(k3)
        array.push(peBasket, k3)
    if not na(k4)
        array.push(peBasket, k4)
    if not na(k5)
        array.push(peBasket, k5)
    if not na(k6)
        array.push(peBasket, k6)
    if not na(k7)
        array.push(peBasket, k7)

float peerMed = na
int peN = array.size(peBasket)
// Pine's `/` returns a float. array.get needs an int index.
int mid = int(peN / 2)
if peN >= 2
    array.sort(peBasket, order.ascending)
    peerMed := peN % 2 == 1 ? array.get(peBasket, mid) : (array.get(peBasket, mid - 1) + array.get(peBasket, mid)) / 2.0

peTxt(float x) =>
    str.tostring(x, "#.#")

// ==========================================
// 3. VISUALIZATION
// ==========================================

set_row(row, title, value, isGood, isBad, string tip = "") =>
    if row < 20  // Safety check to prevent out of bounds
        c_val = isBad ? c_bear : isGood ? c_bull : c_text
        icon = isBad ? "▼" : isGood ? "▲" : "•"
        table.cell(checklistTable, 0, row, title, text_color=c_neut, text_size=size.small, text_halign=text.align_left, tooltip=tip)
        table.cell(checklistTable, 1, row, value, text_color=c_val, text_size=size.small, text_halign=text.align_right, tooltip=tip)
        table.cell(checklistTable, 2, row, icon, text_color=c_val, text_size=size.small, tooltip=tip)

if barstate.islast
    // Initialize row counter
    currentRow = 0
    
    // 1. Context
    set_row(currentRow, "Seasonality", seasonalStr, isStrongMonth, isWeakMonth)
    currentRow := currentRow + 1
    
    // 2. Fundamentals (only for stocks with available data)
    if hasFinancialData
        // Show earnings only if available
        if not na(earningsTime)
            set_row(currentRow, "Earnings", earningsDateStr, false, isEarningsSoon)
            currentRow := currentRow + 1
        
        // Show growth only if data available
        if not (na(salesGrowth) or na(epsGrowth))
            set_row(currentRow, "Growth (S/E)", salesEpsStr, isGrowthStrong, false)
            currentRow := currentRow + 1
        
        // Show acceleration only if data available
        if not (na(salesAcceleration) or na(epsAcceleration))
            set_row(currentRow, "Accel (S/E)", accelerationStr, isBothAccelerating, false)
            currentRow := currentRow + 1

    // Trailing P/E against the same industry, or the same sector when the industry basket is thin.
    if showPE
        string peLabel = "PE"
        string peVal = "N/A"
        bool peCheap = false
        bool peRich = false
        string peTip = ""
        if peEps <= 0
            peVal := na(peerMed) ? "loss" : "loss (vs " + peTxt(peerMed) + ")"
            peTip := "本益比 is not meaningful without trailing earnings." + (na(peerMed) ? "" : " Category median is " + peTxt(peerMed) + ".")
        else if na(peerMed)
            peVal := peTxt(stockPE)
            peTip := "本益比 (TTM P/E). Fewer than two profitable large-cap peers in this category."
        else
            float pePrem = (stockPE / peerMed - 1) * 100
            string premStr = (pePrem > 0 ? "+" : "") + str.tostring(pePrem, "#") + "%"
            peLabel := "PE/" + peerSrc
            peVal := peTxt(stockPE) + " (" + premStr + ")"
            peCheap := stockPE <= peerMed * 0.85
            peRich := stockPE >= peerMed * 1.5
            string catWord = peerSrc == "Ind" ? "industry" : "sector"
            peTip := "本益比 " + peTxt(stockPE) + " vs " + catWord + " median " + peTxt(peerMed) + " (" + str.tostring(peN) + " largest US peers, TTM P/E between 0 and 100). Green: 15% or more below. Red: 50% or more above."
        set_row(currentRow, peLabel, peVal, peCheap, peRich, peTip)
        currentRow := currentRow + 1
        
        // Add section separator after fundamentals if any were shown
    //    if currentRow > 1
      //      set_row(currentRow, "─────", "", false, false)
        //    currentRow := currentRow + 1
    
    // 3. Market Context
    set_row(currentRow, "Mkt(S5TH)", s5thStr, isBreadthOversold, isBreadthOverbought)
    currentRow := currentRow + 1
    set_row(currentRow, "VIX", vixStr, isGreed, isFear)
    currentRow := currentRow + 1
    
    // Add separator after market context
//    set_row(currentRow, "─────", "", false, false)
  //  currentRow := currentRow + 1

    // 4. Group Strength
    // Only show Sector RS if not SPY
    if sectorETF != "AMEX:SPY"
        set_row(currentRow, "Sec(" + secTicker + ")", str.tostring(secRS*100, "#.#") + "%", secRS > 0.02, secRS < -0.02)
        currentRow := currentRow + 1
    
    // Only show Industry RS if valid ETF found and different from Sector ETF
    if not na(industryETF) and sectorETF != industryETF
        set_row(currentRow, "Ind(" + indTicker + ")", str.tostring(indRS*100, "#.#") + "%", indRS > 0.02, indRS < -0.02)
        currentRow := currentRow + 1
    
    // 5. Technicals
    set_row(currentRow, "RS v SPX", str.tostring(rsRating), isRSStrong, isRSWeak)
    currentRow := currentRow + 1
    
    // Only show RS vs Sector if not SPY (avoid duplicate of RS vs SPX)
    if sectorETF != "AMEX:SPY"
        set_row(currentRow, "RS v " + secTicker + "", str.tostring(rsSectorRating), isSectorRSStrong, isSectorRSWeak)
        currentRow := currentRow + 1
    
    // Show Industry RS Rating only if valid ETF found and different ETF
    if not na(industryETF) and sectorETF != industryETF
        set_row(currentRow, "RS v " + indTicker + "", str.tostring(rsIndustryRating), isIndustryRSStrong, isIndustryRSWeak)
