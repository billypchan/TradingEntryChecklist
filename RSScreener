//@version=5
indicator("RS Screener", shorttitle = "RSScreener", overlay = false, dynamic_requests = true)

// RS Screener - Minimal requests version for TradingView Screener
// Outputs: rsRating (vs SPX), rsSectorRating (vs Sector ETF), rsIndustryRating (vs Industry ETF)
// Optimized to use only 3 security requests

// ==========================================
// 1. SECTOR & INDUSTRY ETF MAPPINGS
// ==========================================

// Sector ETF Mapping (largest AUM ETFs)
sectorETF = switch syminfo.sector
    "Technology Services"     => "AMEX:XLK"
    "Electronic Technology"   => "NASDAQ:SMH"
    "Finance"                 => "AMEX:XLF"
    "Health Technology"       => "AMEX:XLV"
    "Health Services"         => "AMEX:XLV"
    "Retail Trade"            => "AMEX:XRT"
    "Consumer Non-Durables"   => "AMEX:XLP"
    "Consumer Durables"       => "AMEX:XLY"
    "Consumer Services"       => "AMEX:XLY"
    "Distribution Services"   => "AMEX:XLY"
    "Producer Manufacturing"  => "AMEX:XLI"
    "Industrial Services"     => "AMEX:XLI"
    "Commercial Services"     => "AMEX:XLI"
    "Energy Minerals"         => "AMEX:XLE"
    "Utilities"               => "AMEX:XLU"
    "Non-Energy Minerals"     => "AMEX:XLB"
    "Process Industries"      => "AMEX:XLB"
    "Transportation"          => "AMEX:IYT"
    "Communications"          => "AMEX:XLC"
    "Miscellaneous"           => "AMEX:VTI"
    => "AMEX:SPY"

// Industry ETF Mapping (largest AUM ETFs)
industryETF = switch syminfo.industry
    // Aerospace & Defense
    "Aerospace & Defense" => "AMEX:ITA"
    // Agriculture
    "Agricultural Commodities/Milling" => "AMEX:MOO"
    // Airlines
    "Airlines" => "AMEX:JETS"
    // Automotive
    "Auto Parts: OEM" => "NASDAQ:CARZ"
    "Automotive Aftermarket" => "NASDAQ:CARZ"
    "Motor Vehicles" => "NASDAQ:CARZ"
    // Banking
    "Major Banks" => "AMEX:KBE"
    "Regional Banks" => "AMEX:KRE"
    "Investment Banks/Brokers" => "AMEX:IAI"
    // Biotechnology
    "Biotechnology" => "NASDAQ:IBB"
    // Building & Construction
    "Building Products" => "AMEX:ITB"
    "Construction Materials" => "AMEX:ITB"
    "Homebuilding" => "AMEX:ITB"
    // Casinos
    "Casinos/Gaming" => "AMEX:BJK"
    // Chemicals
    "Chemicals: Agricultural" => "AMEX:XLB"
    "Chemicals: Major Diversified" => "AMEX:XLB"
    "Chemicals: Specialty" => "AMEX:XLB"
    // Clean Energy
    "Alternative Power Generation" => "NASDAQ:ICLN"
    "Environmental Services" => "NASDAQ:ICLN"
    // Energy
    "Coal" => "AMEX:XLE"
    "Contract Drilling" => "AMEX:OIH"
    "Integrated Oil" => "AMEX:XLE"
    "Oil & Gas Production" => "AMEX:XOP"
    "Oil & Gas Pipelines" => "AMEX:MLPA"
    "Oil Refining/Marketing" => "AMEX:XLE"
    "Oil Equipment & Services" => "AMEX:OIH"
    // Gold & Metals
    "Precious Metals" => "AMEX:GDX"
    "Aluminum" => "AMEX:XME"
    "Metal Fabrication" => "AMEX:XME"
    "Steel" => "AMEX:SLX"
    // Healthcare
    "Medical Specialties" => "AMEX:IHI"
    "Hospital/Nursing Management" => "AMEX:XLV"
    "Managed Health Care" => "AMEX:XLV"
    // Insurance
    "Insurance Brokers/Services" => "AMEX:KIE"
    "Life/Health Insurance" => "AMEX:KIE"
    "Multi-Line Insurance" => "AMEX:KIE"
    // Internet
    "Internet Retail" => "AMEX:IBUY"
    "Internet Software/Services" => "AMEX:FDN"
    // Pharmaceuticals
    "Pharmaceuticals: Major" => "AMEX:XLV"
    "Pharmaceuticals: Other" => "AMEX:XPH"
    // Real Estate
    "Real Estate Development" => "AMEX:VNQ"
    "Real Estate Investment Trusts" => "AMEX:VNQ"
    // Retail
    "Apparel/Footwear" => "AMEX:XRT"
    "Apparel/Footwear Retail" => "AMEX:XRT"
    "Department Stores" => "AMEX:XRT"
    "Discount Stores" => "AMEX:XRT"
    "Specialty Stores" => "AMEX:XRT"
    // Semiconductors
    "Semiconductors" => "NASDAQ:SMH"
    "Electronic Production Equipment" => "NASDAQ:SMH"
    // Software
    "Packaged Software" => "AMEX:IGV"
    // Technology
    "Computer Communications" => "AMEX:XLK"
    "Computer Processing Hardware" => "AMEX:XLK"
    "Data Processing Services" => "AMEX:XLK"
    "Electronic Components" => "AMEX:XLK"
    "Information Technology Services" => "AMEX:XLK"
    // Telecommunications
    "Major Telecommunications" => "AMEX:XLC"
    "Specialty Telecommunications" => "AMEX:XLC"
    "Wireless Telecommunications" => "AMEX:XLC"
    // Timber
    "Forest Products" => "NASDAQ:WOOD"
    // Transportation
    "Air Freight/Couriers" => "AMEX:IYT"
    "Marine Shipping" => "AMEX:BOAT"
    "Trucking" => "AMEX:IYT"
    // Uranium
    "Uranium" => "AMEX:URA"
    // Utilities
    "Electric Utilities" => "AMEX:XLU"
    "Utilities: Water" => "AMEX:PHO"
    // Default to sector ETF if no industry match
    => sectorETF

// ==========================================
// 2. DATA FETCHING (3 requests only)
// ==========================================

// Request 1: SPX data
spxClose = request.security("SP:SPX", "D", close)

// Request 2: Sector ETF data
sectorClose = request.security(sectorETF, "D", close)

// Request 3: Industry ETF data (uses sector if same)
industryClose = industryETF == sectorETF ? sectorClose : request.security(industryETF, "D", close)

// Current stock close (no request needed)
stockClose = close

// ==========================================
// 3. RS CALCULATIONS
// ==========================================

// Rate of change calculation with safety for early bars
calc_roc(src, len) =>
    safe_len = math.min(bar_index, len)
    safe_len > 0 ? src / src[safe_len] : 1.0

// Weighted performance calculation (IBD-style: 40% 3mo, 20% 6mo, 20% 9mo, 20% 12mo)
calc_perf(src) =>
    0.4 * calc_roc(src, 63) + 0.2 * calc_roc(src, 126) + 0.2 * calc_roc(src, 189) + 0.2 * calc_roc(src, 252)

perfStock = calc_perf(stockClose)
perfSPX = calc_perf(spxClose)
perfSector = calc_perf(sectorClose)
perfIndustry = calc_perf(industryClose)

// RS Score calculations
rsScore = perfSPX != 0 ? perfStock / perfSPX * 100 : 0
rsSectorScore = perfSector != 0 ? perfStock / perfSector * 100 : 0
rsIndustryScore = perfIndustry != 0 ? perfStock / perfIndustry * 100 : 0

// Convert to 1-99 rating scale
score_to_rating(score) =>
    score >= 120 ? 99 : score >= 110 ? 90 : score >= 100 ? 80 : score >= 95 ? 70 : score >= 90 ? 60 : score >= 85 ? 50 : score >= 75 ? 40 : score >= 65 ? 30 : score >= 55 ? 20 : score >= 45 ? 10 : 1

rsRating = score_to_rating(rsScore)
rsSectorRating = score_to_rating(rsSectorScore)
rsIndustryRating = score_to_rating(rsIndustryScore)

// ==========================================
// 4. OUTPUTS FOR SCREENER
// ==========================================

// Plot values (for screener column access, hidden by default)
plot(rsRating, "RS Rating", color=color.blue, display=display.data_window + display.status_line)
plot(rsSectorRating, "RS vs Sector", color=color.orange, display=display.data_window + display.status_line)
plot(rsIndustryRating, "RS vs Industry", color=color.purple, display=display.data_window + display.status_line)
