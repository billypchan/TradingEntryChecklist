// 5. Calculate Rel Perf (20D)
calc_rel(asset, bench) =>
    val = asset / asset[20] - 1
    b_val = bench / bench[20] - 1
    val - b_val

secRS = calc_rel(sectorClose, benchmarkClose)
indRS = calc_rel(industryClose, benchmarkClose)

