// Same-country peer price performance. Used outside the US, where the sector ETFs are US funds.
avg8(float a, float b, float c, float d, float e, float f, float g, float h) =>
    float s = 0.0
    int n = 0
    if not na(a)
        s += a
        n += 1
    if not na(b)
        s += b
        n += 1
    if not na(c)
        s += c
        n += 1
    if not na(d)
        s += d
        n += 1
    if not na(e)
        s += e
        n += 1
    if not na(f)
        s += f
        n += 1
    if not na(g)
        s += g
        n += 1
    if not na(h)
        s += h
        n += 1
    [n > 0 ? s / n : na, n]

