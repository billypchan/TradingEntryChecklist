//@version=6
indicator("Entry Checklist", shorttitle = "EntryCheck", overlay = true, dynamic_requests = true)

// Entry Checklist
// A comprehensive multi-factor analysis tool for stock and crypto entry decisions, combining fundamental, technical, and market sentiment indicators in a dynamic table display.

// 🎯 Overview
// This advanced Pine Script indicator provides traders and investors with a systematic checklist for evaluating potential entry points. It consolidates critical market data into a clean, color-coded table that adapts based on asset type and data availability.

// 📊 Key Features
// Market Context Analysis:

// Seasonality: 10-year average return of TAIEX on Taiwan charts, otherwise the S&P 500
// Market Breadth (S5TH): US only. Percentage of S&P 500 stocks above their 50-day moving average
// Fear/Greed Index (VIX): US only
// Fundamental Analysis (Stocks Only):

// Earnings Dates: Upcoming earnings announcement tracking with 14-day warning
// Growth Metrics: Year-over-year sales and EPS growth rates
// Acceleration: Quarter-over-quarter growth acceleration analysis
// P/E (本益比): Trailing P/E vs Taiwan peers on TWSE/TPEX, otherwise vs US peers
// Sector & Industry Analysis:

// Sector Relative Strength: US sector ETF vs SPY. Taiwan uses same-industry peers vs TAIEX
// Industry Relative Strength: US industry ETF, or Taiwan peers on TWSE/TPEX
// 120+ Industry ETF Mappings: Comprehensive sector and industry classifications
// Technical Analysis:

// IBD-Style RS Rating: Multi-timeframe relative strength scoring (1-99 scale)
// RS vs benchmark: TAIEX on TWSE/TPEX, S&P 500 on every other chart
// RS vs Sector / Industry: US ETFs, or the Taiwan peer basket on TWSE/TPEX
// 🎨 Visual Design
// Dynamic Table: Bottom-right overlay with professional dark theme
// Color-Coded Signals: Green (bullish), red (bearish), neutral (white)


// ==========================================
// test cases:
// CRWV - US stock 
// CRWV - US stock with sector/industry
// VOD - DR /ADR
// VIX - verify no fundamental data errors, and VIX is correct
// S5TH - verify S5TH is correct
// BTCUSD - crypto asset, verify no fundamental data errors
// SPX - verify RS = 80
// MT - SLX should be industry ETF, not a stock ticker
// NVO - verify industry ETF mapping works NASDAQ:IBB
// MSTR - verify industry ETF mapping works AMEX:FDN
// HCC - verify industry ETF mapping works XLE
// NVDA - PE/Ind below or near semiconductor large-cap median
// GOOG - PE/Ind vs internet software large caps; loss-makers show "loss"
// BTCUSD - no PE row
// TPEX:5904 - PE vs Taiwan specialty stores, RS v TAIEX, no S5TH or VIX
// TWSE:2330 - PE vs Taiwan semiconductors, RS v TAIEX
// HKEX:700 - US checklist (only Taiwan uses a local peer basket)
// ==========================================

// ==========================================
// 1. CONFIGURATION & SETUP
// ==========================================

// Table Configuration
var table checklistTable = table.new(position.bottom_right, 3, 20, bgcolor=color.rgb(19, 23, 34, 10), frame_width=1, frame_color=color.rgb(42, 46, 57), border_width=1)

// Colors
c_bull = #00E396
c_bear = #FF4560
c_neut = #B2B5BE
c_text = color.white

// ==========================================
// 2. DATA FETCHING & CALCULATIONS
// ==========================================

// --- Determine if asset has fundamental data ---
isCrypto = syminfo.type == "crypto"
isCommodity = syminfo.type == "commodity"
isForex = syminfo.type == "forex" 
isIndex = syminfo.type == "index"
isFund = syminfo.type == "fund"

// --- A. Home market ---
// TWSE and TPEX use Taiwan peers and TAIEX. Every other chart keeps the US checklist.
bool isTaiwan = syminfo.prefix == "TWSE" or syminfo.prefix == "TPEX" or (syminfo.prefix == "" and syminfo.country == "TW")
bool isUSMarket = not isTaiwan
bool showGlobalRisk = not isTaiwan
string benchSym = isTaiwan ? "TWSE:IX0001" : "SP:SPX"
string benchName = isTaiwan ? "TAIEX" : "SPX"
string benchReq = benchSym
string mktPlace = isTaiwan ? "Taiwan" : "US"

// Breadth and VIX are US series. They stay off Taiwan charts.
float s5th = na
float vix = na
if showGlobalRisk
    s5th := request.security("INDEX:S5TH", "D", close, ignore_invalid_symbol=true)
    vix := request.security("CBOE:VIX", "D", close, ignore_invalid_symbol=true)
isBreadthOversold = s5th < 20
isBreadthOverbought = s5th > 80
s5thStr = na(s5th) ? "N/A" : str.tostring(s5th, "0") + "%"
vixStr = na(vix) ? "N/A" : str.tostring(vix, "0")
isGreed = vix <= 15
isFear = vix >= 25

// --- B. Earnings Date Check ---
// Try to get earnings data to determine if financial data is available
earningsTime = earnings.future_time
hasFinancialData = not na(earningsTime)
daysUntilEarnings = not na(earningsTime) ? (earningsTime - timenow) / 86400000 : na
isEarningsSoon = not na(daysUntilEarnings) and daysUntilEarnings >= 0 and daysUntilEarnings <= 14
earningsDateStr = na(earningsTime) ? "N/A" : str.format("{0,date,MMMdd}", earningsTime)

// --- C. Seasonality of the home index ---
// Completed same-calendar-month returns over the last 10 years. The current month is excluded.
monthHistAvg() =>
    float s = 0.0
    int n = 0
    if not na(close[13]) and close[13] != 0
        s += close[12] / close[13] - 1.0
        n += 1
    if not na(close[25]) and close[25] != 0
        s += close[24] / close[25] - 1.0
        n += 1
    if not na(close[37]) and close[37] != 0
        s += close[36] / close[37] - 1.0
        n += 1
    if not na(close[49]) and close[49] != 0
        s += close[48] / close[49] - 1.0
        n += 1
    if not na(close[61]) and close[61] != 0
        s += close[60] / close[61] - 1.0
        n += 1
    if not na(close[73]) and close[73] != 0
        s += close[72] / close[73] - 1.0
        n += 1
    if not na(close[85]) and close[85] != 0
        s += close[84] / close[85] - 1.0
        n += 1
    if not na(close[97]) and close[97] != 0
        s += close[96] / close[97] - 1.0
        n += 1
    if not na(close[109]) and close[109] != 0
        s += close[108] / close[109] - 1.0
        n += 1
    if not na(close[121]) and close[121] != 0
        s += close[120] / close[121] - 1.0
        n += 1
    n >= 5 ? s / n * 100.0 : na

currentMonth = month(timenow)
seasRet = request.security(benchReq, "M", monthHistAvg(), ignore_invalid_symbol=true)
isWeakMonth = seasRet < 0.50
isStrongMonth = seasRet > 1.40

monthName = switch currentMonth
    1 => "Jan"
    2 => "Feb"
    3 => "Mar"
    4 => "Apr"
    5 => "May"
    6 => "Jun"
    7 => "Jul"
    8 => "Aug"
    9 => "Sep"
    10 => "Oct"
    11 => "Nov"
    12 => "Dec"
    => "N/A"

// Whole numbers only, so the table fits a phone.
n0(float x) =>
    str.tostring(x, "0")

sgn0(float x) =>
    string t = n0(x)
    x > 0 and t != "0" ? "+" + t : t

seasonalStr = na(seasRet) ? "N/A" : monthName + sgn0(seasRet)

// --- D. RS Rating vs SPX (IBD Style) ---
[benchClose, stockClose] = request.security(syminfo.tickerid, "D", [request.security(benchReq, "D", close, ignore_invalid_symbol=true), close])

calc_roc(src, len) =>
    safe_len = math.min(bar_index, len)
    src / src[safe_len]

rsBucket(float score) =>
    score >= 120 ? 99 : score >= 110 ? 90 : score >= 100 ? 80 : score >= 95 ? 70 : score >= 90 ? 60 : score >= 85 ? 50 : score >= 75 ? 40 : score >= 65 ? 30 : score >= 55 ? 20 : score >= 45 ? 10 : 1

perfStock = 0.4 * calc_roc(stockClose, 63) + 0.2 * calc_roc(stockClose, 126) + 0.2 * calc_roc(stockClose, 189) + 0.2 * calc_roc(stockClose, 252)
perfBench = 0.4 * calc_roc(benchClose, 63) + 0.2 * calc_roc(benchClose, 126) + 0.2 * calc_roc(benchClose, 189) + 0.2 * calc_roc(benchClose, 252)
rsScore   = perfBench != 0 ? perfStock / perfBench * 100 : 0
rsRating = rsBucket(rsScore)
isRSWeak = rsRating < 65
isRSStrong = rsRating >= 80

// --- E. Growth Metrics ---
// TTM versus four fiscal quarters earlier. The offsets live on the quarterly
// series: a chart-bar offset of 252 is one year only on a daily chart, and on
// intraday charts the figure matched itself and the row printed 0/0.
finQ() =>
    float rev = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "TTM")
    float eps = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "TTM")
    [rev, rev[1], rev[4], rev[5], eps, eps[1], eps[4], eps[5]]

[salesTTM, sales1Q, sales4Q, sales5Q, epsTTM, eps1Q, eps4Q, eps5Q] = request.security(syminfo.tickerid, "3M", finQ(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Positive base only. A loss in the base period makes the percent meaningless.
calc_growth(cur, prev) => (not na(cur) and not na(prev) and prev > 0) ? (cur / prev - 1) : na
salesGrowth = calc_growth(salesTTM, sales4Q)
epsGrowth = calc_growth(epsTTM, eps4Q)
salesEpsStr = not hasFinancialData ? "No Data" : (na(salesGrowth) or na(epsGrowth)) ? "N/A" : n0(salesGrowth * 100) + "/" + n0(epsGrowth * 100)
isGrowthStrong = hasFinancialData and nz(salesGrowth) > 0.15 and nz(epsGrowth) > 0.15

// --- F. Earnings Acceleration Check ---
// Change in the year-over-year rate versus the prior fiscal quarter.
// Prior rate uses the quarter then, over the quarter five periods earlier.
prevSalesGrowth = calc_growth(sales1Q, sales5Q)
prevEpsGrowth = calc_growth(eps1Q, eps5Q)

isSalesAccelerating = hasFinancialData and not na(salesGrowth) and not na(prevSalesGrowth) and salesGrowth > prevSalesGrowth
isEpsAccelerating = hasFinancialData and not na(epsGrowth) and not na(prevEpsGrowth) and epsGrowth > prevEpsGrowth
isBothAccelerating = hasFinancialData and isSalesAccelerating and isEpsAccelerating

salesAcceleration = hasFinancialData and not na(salesGrowth) and not na(prevSalesGrowth) ? (salesGrowth - prevSalesGrowth) * 100 : na
epsAcceleration = hasFinancialData and not na(epsGrowth) and not na(prevEpsGrowth) ? (epsGrowth - prevEpsGrowth) * 100 : na

accelerationStr = not hasFinancialData ? "No Data" : (na(salesAcceleration) or na(epsAcceleration)) ? "N/A" : n0(salesAcceleration) + "/" + n0(epsAcceleration)

// --- G. Enhanced Sector & Industry Logic ---

findList(string table, string kind, string name) =>
    string out = ""
    if name != "" and table != ""
        string key = "\n" + kind + "\t" + name + "\t"
        int at = str.pos(table, key)
        if not na(at)
            string rest = str.substring(table, at + str.length(key))
            int nl = str.pos(rest, "\n")
            out := na(nl) ? rest : str.substring(rest, 0, nl)
    out

