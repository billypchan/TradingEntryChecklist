// Helper to extract ticker from "EXCHANGE:TICKER" format
getTicker(etf) => 
    colonPos = str.pos(etf, ":")
    colonPos >= 0 ? str.substring(etf, colonPos + 1) : etf

secTicker = getTicker(sectorETF)
indTicker = na(industryETF) ? "" : getTicker(industryETF)


// --- H. Trailing P/E vs same-category stocks (本益比) ---
// Pine cannot list every symbol in an industry. Each basket stores the four largest
// names. TWSE and TPEX use Taiwan. Every other chart uses the US list, names over $1B.
// Sector is the fallback when the industry basket is missing. Snapshot: 2026-10-13.
// The multiple is live: daily close / trailing twelve-month EPS.
// Peers with no earnings or a TTM P/E above 100 are left out of the median so a
// one-off earnings collapse does not set the category multiple.
// Cheap (green): stock P/E at least 15% below the category median.
// Rich (red): stock P/E at least 50% above the category median.
tickerAt(string raw, int idx) =>
    string out = ""
    if raw != ""
        array<string> parts = str.split(raw, ",")
        if idx < array.size(parts)
            out := array.get(parts, idx)
    out

// Empty slots reuse SPY. Identical requests are cached, and SPY has no EPS so it
// cannot enter the median.
// Daily lookbacks stay inside request.security. Indexing that result on the
// chart keeps a 20-bar buffer, and offset 126 then throws (COCO peer basket).
peerStats(string tk) =>
    string sym = tk == "" ? "AMEX:SPY" : tk
    [px, c20, c63, c126, c189, c252] = request.security(sym, "D", [close, close[20], close[63], close[126], close[189], close[252]], ignore_invalid_symbol=true)
    bool isSelf = tk != "" and (tk == syminfo.tickerid or str.endswith(tk, ":" + syminfo.ticker))
    bool ok = tk != "" and not isSelf and not na(px)
    float r20 = ok and not na(c20) and c20 != 0 ? px / c20 - 1 : na
    float r63 = ok and not na(c63) and c63 != 0 ? px / c63 : na
    float r126 = ok and not na(c126) and c126 != 0 ? px / c126 : na
    float r189 = ok and not na(c189) and c189 != 0 ? px / c189 : na
    float r252 = ok and not na(c252) and c252 != 0 ? px / c252 : na
    float wp = not na(r63) and not na(r126) and not na(r189) and not na(r252) ? 0.4 * r63 + 0.2 * r126 + 0.2 * r189 + 0.2 * r252 : na
    [px, r20, wp]

peerEarn(string tk) =>
    request.financial(tk == "" ? "AMEX:SPY" : tk, "EARNINGS_PER_SHARE", "TTM", ignore_invalid_symbol=true)

// Drop this symbol and peers whose TTM P/E is not in (0, 100].
keptPE(string tk, float px, float e) =>
    bool isSelf = tk != "" and (tk == syminfo.tickerid or str.endswith(tk, ":" + syminfo.ticker))
    float pe = not isSelf and not na(px) and not na(e) and e > 0 ? px / e : na
    pe > 0 and pe <= 100 ? pe : na

// Peer baskets. Taiwan listings use Taiwan names. Every other chart uses the US names.
