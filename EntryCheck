set_row(row, title, value, isGood, isBad, string tip = "") =>
    if row < 20  // Safety check to prevent out of bounds
        c_val = isBad ? c_bear : isGood ? c_bull : c_text
        icon = isBad ? "▼" : isGood ? "▲" : "•"
        table.cell(checklistTable, 0, row, title, text_color=c_neut, text_size=size.tiny, text_halign=text.align_left, tooltip=tip)
        table.cell(checklistTable, 1, row, value, text_color=c_val, text_size=size.tiny, text_halign=text.align_right, tooltip=tip)
        table.cell(checklistTable, 2, row, icon, text_color=c_val, text_size=size.tiny, tooltip=tip)

if barstate.islast
    // Initialize row counter
    currentRow = 0
    
    // 1. Context
    if benchSym != ""
        set_row(currentRow, "S " + benchName, seasonalStr, isStrongMonth, isWeakMonth, "Average " + benchName + " return for this calendar month over the last 10 completed years.")
        currentRow := currentRow + 1
    
    // 2. Fundamentals (only for stocks with available data)
    if hasFinancialData
        // Show earnings only if available
        if not na(earningsTime)
            set_row(currentRow, "Earn", earningsDateStr, false, isEarningsSoon)
            currentRow := currentRow + 1
        
        // Show growth only if data available
        if not (na(salesGrowth) or na(epsGrowth))
            set_row(currentRow, "Grw", salesEpsStr, isGrowthStrong, false, "TTM sales / EPS versus four fiscal quarters ago, percent.")
            currentRow := currentRow + 1
        
        // Show acceleration only if data available
        if not (na(salesAcceleration) or na(epsAcceleration))
            set_row(currentRow, "Acc", accelerationStr, isBothAccelerating, false, "Change in that year-over-year rate versus the prior fiscal quarter, in percentage points.")
            currentRow := currentRow + 1

    // Trailing P/E against the same industry, or the same sector when the industry basket is thin.
    if showPE
        string peLabel = "PE"
        string peVal = "N/A"
        bool peCheap = false
        bool peRich = false
        string peTip = ""
        if peEps <= 0
            peVal := "loss"
            peTip := "本益比 is not meaningful without trailing earnings." + (na(peerMed) ? "" : " Category median is " + peTxt(peerMed) + ".")
        else if na(peerMed)
            peVal := peTxt(stockPE)
            peTip := "本益比 (TTM P/E). Fewer than two profitable " + mktPlace + " peers in this category."
        else
            float pePrem = (stockPE / peerMed - 1) * 100
            peLabel := "PE/" + peerSrc
            peVal := peTxt(stockPE) + "/" + sgn0(pePrem)
            peCheap := stockPE <= peerMed * 0.85
            peRich := stockPE >= peerMed * 1.5
            string catWord = peerSrc == "Ind" ? "industry" : "sector"
            peTip := "本益比 " + peTxt(stockPE) + " vs " + mktPlace + " " + catWord + " median " + peTxt(peerMed) + " (" + str.tostring(peN) + " largest " + mktPlace + " peers, TTM P/E between 0 and 100). Green: 15% or more below. Red: 50% or more above."
        set_row(currentRow, peLabel, peVal, peCheap, peRich, peTip)
        currentRow := currentRow + 1
        
        // Add section separator after fundamentals if any were shown
    //    if currentRow > 1
      //      set_row(currentRow, "─────", "", false, false)
        //    currentRow := currentRow + 1
    
    // 3. Market Context. S5TH and VIX are US series, so they stay off other countries.
